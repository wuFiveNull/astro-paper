---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const defaultReturnTo = getRelativeLocaleUrl(locale, "account");
const requestedReturnTo = Astro.url.searchParams.get("returnTo");
const returnTo = requestedReturnTo?.startsWith("/") && !requestedReturnTo.startsWith("//")
  ? requestedReturnTo
  : defaultReturnTo;
---

<Layout title={`${t.pages.loginTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.loginTitle} class="max-w-app">
    <p class="text-muted-foreground mt-2 mb-6">
      Accounts are created by an administrator.
    </p>
    <form
      id="login-form"
      class="max-w-xl space-y-4"
      data-return-to={returnTo}
    >
      <div>
        <label for="login-username" class="mb-1 block text-sm font-medium">Username</label>
        <input
          id="login-username"
          name="username"
          type="text"
          autocomplete="username"
          maxlength="50"
          required
          class="border-border bg-background text-foreground focus-visible:outline-accent w-full rounded border px-3 py-2 focus-visible:outline-2"
        />
      </div>
      <div>
        <label for="login-password" class="mb-1 block text-sm font-medium">Password</label>
        <input
          id="login-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="border-border bg-background text-foreground focus-visible:outline-accent w-full rounded border px-3 py-2 focus-visible:outline-2"
        />
      </div>
      <p id="login-status" class="text-sm" role="status" aria-live="polite"></p>
      <button
        type="submit"
        class="bg-accent text-accent-foreground rounded px-4 py-2 font-medium hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Sign in
      </button>
    </form>
  </Main>

  <Footer />
</Layout>

<script>
  import { sendJson } from "@/lib/session-api";

  function setupLoginForm() {
    const form = document.querySelector<HTMLFormElement>("#login-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async event => {
      event.preventDefault();
      const username = form.querySelector<HTMLInputElement>("[name=username]");
      const password = form.querySelector<HTMLInputElement>("[name=password]");
      const status = form.querySelector<HTMLElement>("#login-status");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!username || !password || !status) return;

      if (button) button.disabled = true;
      status.classList.remove("text-red-600");
      status.textContent = "Signing in…";
      try {
        await sendJson("/api/v1/auth/login", "POST", {
          username: username.value,
          password: password.value,
        });
        window.location.assign(form.dataset.returnTo ?? "/account");
      } catch (error) {
        status.classList.add("text-red-600");
        status.textContent = error instanceof Error ? error.message : "Sign in failed.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  setupLoginForm();
  document.addEventListener("astro:page-load", setupLoginForm);
</script>
