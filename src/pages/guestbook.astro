---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const loginUrl = new URL(getRelativeLocaleUrl(locale, "login"), Astro.url);
loginUrl.searchParams.set("returnTo", Astro.url.pathname);
---

<Layout title={`${t.pages.guestbookTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.guestbookTitle} class="max-w-app">
    <p class="text-muted-foreground mt-2 mb-6">
      Send a private message to the site administrator. Messages are not shown publicly.
    </p>
    <p id="guestbook-status" class="text-muted-foreground text-sm" role="status" aria-live="polite">
      Checking account…
    </p>
    <a
      id="guestbook-login-link"
      class="text-accent mt-4 inline-block underline underline-offset-4"
      href={`${loginUrl.pathname}${loginUrl.search}`}
      hidden
    >
      Sign in to leave a message
    </a>

    <form id="guestbook-form" class="mt-5 max-w-xl space-y-4" hidden>
      <div>
        <label for="guestbook-subject" class="mb-1 block text-sm font-medium">Subject (optional)</label>
        <input
          id="guestbook-subject"
          name="subject"
          type="text"
          maxlength="200"
          class="border-border bg-background text-foreground focus-visible:outline-accent w-full rounded border px-3 py-2 focus-visible:outline-2"
        />
      </div>
      <div>
        <label for="guestbook-body" class="mb-1 block text-sm font-medium">Message</label>
        <textarea
          id="guestbook-body"
          name="body"
          rows="6"
          maxlength="10000"
          required
          class="border-border bg-background text-foreground focus-visible:outline-accent w-full rounded border px-3 py-2 focus-visible:outline-2"
        ></textarea>
      </div>
      <button
        type="submit"
        class="bg-accent text-accent-foreground rounded px-4 py-2 font-medium hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send message
      </button>
    </form>
  </Main>

  <Footer />
</Layout>

<script>
  import { getSessionUser, sendJson } from "@/lib/session-api";

  function setupGuestbook() {
    const status = document.querySelector<HTMLElement>("#guestbook-status");
    const form = document.querySelector<HTMLFormElement>("#guestbook-form");
    const loginLink = document.querySelector<HTMLAnchorElement>("#guestbook-login-link");
    if (!status || !form || !loginLink) return;

    status.classList.remove("text-red-600");
    status.textContent = "Checking account…";
    form.hidden = true;
    loginLink.hidden = true;
    void getSessionUser().then(user => {
      if (user?.permissions.includes("message:create")) {
        status.textContent = `Sending as ${user.displayName}.`;
        form.hidden = false;
      } else if (user) {
        status.textContent = "This account cannot send guestbook messages.";
      } else {
        status.textContent = "Sign in before sending a message.";
        loginLink.hidden = false;
      }
    }).catch(error => {
      status.classList.add("text-red-600");
      status.textContent = error instanceof Error ? error.message : "Account is unavailable.";
    });

    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    form.addEventListener("submit", async event => {
      event.preventDefault();
      const subject = form.querySelector<HTMLInputElement>("[name=subject]");
      const body = form.querySelector<HTMLTextAreaElement>("[name=body]");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!subject || !body) return;
      if (button) button.disabled = true;
      status.classList.remove("text-red-600");
      status.textContent = "Sending…";
      try {
        await sendJson("/api/v1/messages", "POST", {
          subject: subject.value,
          body: body.value,
        });
        subject.value = "";
        body.value = "";
        status.textContent = "Your message was sent privately to the administrator.";
      } catch (error) {
        status.classList.add("text-red-600");
        status.textContent = error instanceof Error ? error.message : "Message could not be sent.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  setupGuestbook();
  document.addEventListener("astro:page-load", setupGuestbook);
</script>
