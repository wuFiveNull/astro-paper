---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { createPagination, searchPosts } from "@/lib/blog-api";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
if (config.features.search !== "database") {
  return Astro.rewrite(new URL("/404", Astro.url));
}

const query = (Astro.url.searchParams.get("q") ?? "").trim();
if (query.length > 100) {
  return new Response("Search phrase must be 100 characters or fewer.", {
    status: 400,
  });
}

const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1");
const currentPage =
  Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const results = query
  ? await searchPosts(query, currentPage - 1, config.posts.perPage)
  : null;
const page = results
  ? createPagination(
      currentPage,
      Math.max(results.totalPages, 1),
      pageNumber => {
        const url = new URL(getRelativeLocaleUrl(locale, "search"), Astro.url);
        url.searchParams.set("q", query);
        url.searchParams.set("page", String(pageNumber));
        return `${url.pathname}${url.search}`;
      }
    )
  : null;

const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    <form
      role="search"
      method="get"
      action={getRelativeLocaleUrl(locale, "search")}
      class="mb-8 flex flex-col gap-3 sm:flex-row"
    >
      <label class="sr-only" for="search-query">Search posts</label>
      <input
        id="search-query"
        name="q"
        type="search"
        value={query}
        maxlength="100"
        placeholder="Search posts"
        class="border-border bg-background text-foreground focus-visible:outline-accent min-w-0 flex-1 rounded border px-3 py-2 focus-visible:outline-2"
      />
      <button
        type="submit"
        class="bg-accent text-accent-foreground rounded px-4 py-2 font-medium hover:opacity-90"
      >
        Search
      </button>
    </form>

    {
      query && results && (
        <>
          <p class="text-muted-foreground mb-4 text-sm">
            {results.totalElements} results for “{query}”
          </p>
          <ul>
            {results.content.map(post => (
              <Card {...post} />
            ))}
          </ul>
          {page && <Pagination {page} />}
        </>
      )
    }
  </Main>

  <Footer />
</Layout>
