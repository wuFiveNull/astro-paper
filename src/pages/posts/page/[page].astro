---
import { getRelativeLocaleUrl } from "astro:i18n";
import PostListPage from "@/components/PostListPage.astro";
import { createPagination, getPosts } from "@/lib/blog-api";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const rawPage = Astro.params.page ?? "";
if (!/^\d+$/.test(rawPage) || Number(rawPage) < 2) {
  return Astro.rewrite(getRelativeLocaleUrl(config.site.lang, "404"));
}

const locale = Astro.currentLocale ?? config.site.lang;
const currentPage = Number(rawPage);
const t = useTranslations(locale);
const response = await getPosts(currentPage - 1, config.posts.perPage);
if (currentPage > response.totalPages) {
  return Astro.rewrite(getRelativeLocaleUrl(locale, "404"));
}

const page = createPagination(currentPage, response.totalPages, pageNumber =>
  getRelativeLocaleUrl(
    locale,
    pageNumber === 1 ? "posts" : `posts/${pageNumber}`
  )
);
---

<PostListPage
  title={`${t.pages.postsTitle} | ${config.site.title}`}
  pageTitle={t.pages.postsTitle}
  pageDesc={t.pages.postsDesc}
  posts={response.content}
  {page}
/>
