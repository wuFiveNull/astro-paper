---
type Props = {
  postSlug: string;
  loginUrl: string;
};

const { postSlug, loginUrl } = Astro.props;
---

<section
  id="comments"
  class="mt-8"
  data-post-slug={postSlug}
  data-login-url={loginUrl}
>
  <h2 class="text-xl font-semibold sm:text-2xl">Comments</h2>
  <p class="text-muted-foreground mt-2 text-sm">
    Comments appear after they have been reviewed.
  </p>

  <p id="comments-status" class="mt-4 text-sm" role="status" aria-live="polite"></p>
  <div id="comments-list" class="mt-5 space-y-5"></div>

  <a
    id="comments-login-link"
    class="text-accent mt-6 inline-block underline underline-offset-4"
    href={loginUrl}
    hidden
  >
    Sign in to write a comment
  </a>

  <form id="comment-form" class="mt-6 space-y-3" hidden>
    <label for="comment-body" class="block text-sm font-medium">Write a comment</label>
    <textarea
      id="comment-body"
      name="body"
      rows="4"
      maxlength="5000"
      required
      class="border-border bg-background text-foreground focus-visible:outline-accent w-full rounded border px-3 py-2 focus-visible:outline-2"
    ></textarea>
    <button
      type="submit"
      class="bg-accent text-accent-foreground rounded px-4 py-2 font-medium hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
    >
      Submit for review
    </button>
  </form>
</section>

<script>
  import { getSessionUser, sendJson } from "@/lib/session-api";

  type Comment = {
    id: number;
    parentId: number | null;
    authorName: string;
    body: string;
    createdAt: string | null;
  };

  function setupCommentsPage() {
    const section = document.querySelector<HTMLElement>("#comments");
    const list = document.querySelector<HTMLElement>("#comments-list");
    const status = document.querySelector<HTMLElement>("#comments-status");
    const form = document.querySelector<HTMLFormElement>("#comment-form");
    const bodyInput = document.querySelector<HTMLTextAreaElement>("#comment-body");
    const loginLink = document.querySelector<HTMLAnchorElement>("#comments-login-link");

    function setStatus(message: string, isError = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle("text-red-600", isError);
      status.classList.toggle("text-muted-foreground", !isError);
    }

    function renderComment(comment: Comment) {
      const item = document.createElement("article");
      item.className = "border-border border-s-2 ps-4";

    const heading = document.createElement("div");
    heading.className = "flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm";
    const author = document.createElement("strong");
    author.className = "font-semibold";
    author.textContent = comment.authorName;
    heading.append(author);

    if (comment.parentId !== null) {
      const reply = document.createElement("span");
      reply.className = "text-muted-foreground";
      reply.textContent = "Reply";
      heading.append(reply);
    }

    if (comment.createdAt) {
      const date = document.createElement("time");
      date.className = "text-muted-foreground";
      date.dateTime = comment.createdAt;
      date.textContent = new Intl.DateTimeFormat(document.documentElement.lang, {
        dateStyle: "medium",
      }).format(new Date(comment.createdAt));
      heading.append(date);
    }

    const body = document.createElement("p");
    body.className = "mt-2 whitespace-pre-wrap break-words text-sm leading-6";
    body.textContent = comment.body;
    item.append(heading, body);
      return item;
    }

    async function loadComments() {
      if (!section || !list) return;
    const query = new URLSearchParams({
      postSlug: section.dataset.postSlug ?? "",
      page: "0",
      size: "100",
    });
    const response = await fetch(`/api/v1/comments?${query}`, {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    });
    if (!response.ok) throw new Error("Comments could not be loaded.");
    const page = (await response.json()) as { content: Comment[] };
    list.replaceChildren();
    if (page.content.length === 0) {
      const empty = document.createElement("p");
      empty.className = "text-muted-foreground mt-5 text-sm";
      empty.textContent = "No approved comments yet.";
      list.append(empty);
      return;
    }
      for (const comment of page.content) list.append(renderComment(comment));
    }

    async function initializeComments() {
      if (!form || !loginLink || !section) return;
      form.hidden = true;
      loginLink.hidden = true;
      status && (status.textContent = "");
    try {
      const user = await getSessionUser();
      if (user?.permissions.includes("comment:create")) {
        form.hidden = false;
      } else {
        loginLink.hidden = Boolean(user);
        if (user) setStatus("This account cannot submit comments.");
      }
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Account status is unavailable.", true);
    }
    }

    if (form && form.dataset.bound !== "true") {
      form.dataset.bound = "true";
      form.addEventListener("submit", async event => {
        event.preventDefault();
        if (!section || !bodyInput) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (button) button.disabled = true;
        setStatus("Submitting…");
        try {
          await sendJson("/api/v1/comments", "POST", {
            postSlug: section.dataset.postSlug,
            body: bodyInput.value,
          });
          bodyInput.value = "";
          setStatus("Your comment was submitted for review.");
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "Comment submission failed.", true);
        } finally {
          if (button) button.disabled = false;
        }
      });
    }

    void Promise.all([loadComments(), initializeComments()]).catch(error => {
      setStatus(error instanceof Error ? error.message : "Comments are unavailable.", true);
    });
  }

  setupCommentsPage();
  document.addEventListener("astro:page-load", setupCommentsPage);
</script>
