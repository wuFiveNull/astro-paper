---
import { getRelativeLocaleUrl } from "astro:i18n";
import PostListPage from "@/components/PostListPage.astro";
import { createPagination, getPosts } from "@/lib/blog-api";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const response = await getPosts(0, config.posts.perPage);
const page = createPagination(1, Math.max(response.totalPages, 1), pageNumber =>
  getRelativeLocaleUrl(
    locale,
    pageNumber === 1 ? "posts" : `posts/${pageNumber}`
  )
);
---

<PostListPage
  title={`${t.pages.postsTitle} | ${config.site.title}`}
  pageTitle={t.pages.postsTitle}
  pageDesc={t.pages.postsDesc}
  posts={response.content}
  {page}
/>
