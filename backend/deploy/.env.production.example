# Copy this file to a private server-side .env and replace every placeholder.
# Never commit the filled-in file.
COMPOSE_PROJECT_NAME=astro-paper
MYSQL_DATABASE=astro_paper
DB_USERNAME=astro_paper_app
DB_PASSWORD=replace-with-a-random-private-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-private-value
MYSQL_VOLUME_NAME=astro_paper_mysql_data

# The image must be built by CI or another trusted build host before deployment.
WEB_IMAGE=ghcr.io/replace-owner/astro-paper-web:replace-tag

# Keep the application private until the reverse proxy cutover is approved.
API_HOST_PORT=18083
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=18084
SESSION_COOKIE_SECURE=true
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional container memory overrides for a host with a different capacity.
MYSQL_MEM_LIMIT=384m
API_MEM_LIMIT=512m
WEB_MEM_LIMIT=384m
